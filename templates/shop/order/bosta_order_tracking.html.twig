{% set order = hookable_metadata.context.order %}

{% for shipment in order.shipments %}
    {% set delivery = bosta_delivery(shipment) %}
    {% if delivery is not null and delivery.created and delivery.trackingNumber %}
        <div class="card mb-4" {{ sylius_test_html_attribute('bosta-order-tracking') }}>
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    {% include '@StorkplusSyliusBostaShippingPlugin/shared/bosta_logo.svg.twig' with { height: 22 } %}
                    <div>
                        <div class="fw-bold">{{ shipment.method.name }}</div>
                        <div class="text-body-secondary small">
                            {{ 'storkplus_sylius_bosta_shipping.ui.tracking_number'|trans }}: <span class="font-monospace">{{ delivery.trackingNumber }}</span>
                            {% if delivery.stateLabel %} · {{ delivery.stateLabel }}{% endif %}
                        </div>
                    </div>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="{{ bosta_customer_tracking_url(delivery.trackingNumber) }}" target="_blank" rel="noopener">
                    {{ 'storkplus_sylius_bosta_shipping.ui.track_short'|trans }}
                </a>
            </div>
        </div>
    {% endif %}
{% endfor %}
